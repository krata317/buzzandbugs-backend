{
  "name": "buzz-and-bugs-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Buzz and Bugs, a developer community platform.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,prisma}/**/*.{ts,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,tests,prisma}/**/*.{ts,json}\" \"*.{json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:status": "prisma migrate status",
    "admin:create": "tsx src/cli/admin-create.ts",
    "admin:password": "tsx src/cli/admin-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "nodemailer": "^6.9.16",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
