# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Public base URL of this API (used to build links in emails and media URLs).
APP_BASE_URL=http://localhost:4000

# Comma separated list of browser origins allowed to call the API with cookies.
WEB_ORIGINS=http://localhost:3000,http://localhost:5173

# Technical burst protection applied to every route (per IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bnb:CHANGE_ME@localhost:5432/bnb?schema=public

# Optional: used by `npm test` to build the test database URL. When empty the
# suite derives it from DATABASE_URL by replacing the database name with "bnb_test".
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets (generate real values, never commit them)
# ---------------------------------------------------------------------------
# Random string, at least 32 characters. Used to sign CSRF tokens and keyed hashes.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Random string, at least 32 characters. Used to key the e-mail restriction hash.
EMAIL_HASH_SECRET=replace-with-a-different-long-random-string-32-chars

# ---------------------------------------------------------------------------
# Email (Nodemailer / SMTP)
# ---------------------------------------------------------------------------
# smtp = deliver through SMTP, json = do not deliver, log message metadata only.
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURE_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Buzz and Bugs

# ---------------------------------------------------------------------------
# External APIs (optional until you enable the feature)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Link previews (linkpreview.net)
# ---------------------------------------------------------------------------
# Leave LINK_PREVIEW_API_KEY empty to disable. News uses feed metadata first and only asks for a
# preview when the summary or image is missing.
LINK_PREVIEW_API_URL=https://api.linkpreview.net/
LINK_PREVIEW_API_KEY=
# Maximum provider requests per rolling 24 hours (protects your plan quota).
LINK_PREVIEW_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./var/uploads

# ---------------------------------------------------------------------------
# Admin bootstrap (only read by `npm run admin:create`)
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
